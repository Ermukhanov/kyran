# Локально: скопируйте в .env. На Railway — вкладка Variables.

# Обязательно
TELEGRAM_BOT_TOKEN=            # от @BotFather
DATABASE_URL=                  # на Railway: ${{Postgres.DATABASE_URL}}

# Подключить, когда будут
ANTHROPIC_API_KEY=             # ИИ: оценка, разбор, агент
GOSZAKUP_TOKEN=                # токен Минфина к ows.goszakup.gov.kz

# Настройки
ADMIN_IDS=                     # ваш Telegram ID, для /stats
DEMO_MODE=true                 # демо-лоты для показов, пока нет GOSZAKUP_TOKEN (false — выключить)
SECRET_KEY=                    # любая длинная случайная строка (подпись ссылок /web)
# PUBLIC_URL=                  # не нужно на Railway: берётся из RAILWAY_PUBLIC_DOMAIN

# Текст для клиента после заявки на тариф (реквизиты, Kaspi)
PAYMENT_INFO=
